# ─── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Get your connection string from: https://console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@your-project.neon.tech/pasoa?sslmode=require

# ─── JWT Signing (used by Netlify Identity) ────────────────────────────────────
# Netlify Identity sets this automatically on the Netlify platform.
# For local dev with netlify-cli, it is set via netlify.toml [dev] or env.
JWT_SECRET=your-jwt-secret-here

# ─── Netlify Identity ─────────────────────────────────────────────────────────
# Auto-populated by Netlify platform. Only needed for local dev.
# Must match the site URL where Netlify Identity is enabled.
# Example: https://your-site.netlify.app
NETLIFY_IDENTITY_URL=

# ─── Admin seed (used only during DB seeding, never in Functions) ─────────────
# SEED_ADMIN_EMAIL=admin@pasoa.pup.edu.ph
# SEED_ADMIN_PASSWORD=change-this-immediately
